{
  "name": "corepos-desktop",
  "productName": "CorePOS",
  "version": "1.0.0",
  "description": "CorePOS - offline point of sale for retail shops",
  "author": "CorePOS",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "prepare:php:win": "node scripts/prepare-php.mjs",
    "prepare:php:mac": "node scripts/prepare-php-mac.mjs",
    "prepare:app": "node scripts/prepare-app.mjs",
    "start": "electron .",
    "dist:win": "npm run prepare:php:win && npm run prepare:app && electron-builder --win nsis --x64",
    "dist:win:mac": "npm run prepare:php:win && npm run prepare:app && electron-builder --win nsis --x64 -c.win.signAndEditExecutable=false",
    "dist:mac": "npm run prepare:php:mac && npm run prepare:app && electron-builder --mac dmg --universal",
    "dist:all": "npm run prepare:php:win && npm run prepare:php:mac && npm run prepare:app && electron-builder --mac dmg --universal && electron-builder --win nsis --x64 -c.win.signAndEditExecutable=false",
    "test:license": "node scripts/test-license.mjs"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "pk.corepos.desktop",
    "productName": "CorePOS",
    "copyright": "CorePOS",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "app.config.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "resources/php",
          "to": "php"
        },
        {
          "from": "resources/vc_redist.x64.exe",
          "to": "vc_redist.x64.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "CorePOS",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "CorePOS-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "extraResources": [
        {
          "from": "resources/php-mac-${arch}",
          "to": "php"
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "artifactName": "CorePOS-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "CorePOS ${version}",
      "artifactName": "CorePOS-${version}-mac-${arch}.${ext}"
    },
    "afterPack": "build/after-pack.cjs"
  }
}
