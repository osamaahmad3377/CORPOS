# Copy to .env.local for local development, or add each variable in
# Vercel -> Project -> Settings -> Environment Variables.
# Generate the key pair + session secret with:  npm run gen-keys

# Postgres connection string. Set automatically by the Vercel Neon integration.
# Leave unset locally to use the embedded PGlite database in ./.pglite
DATABASE_URL=

# Ed25519 private key: base64 of PKCS8 DER. SECRET.
LICENSE_PRIVATE_KEY=

# Ed25519 public key: base64 of the RAW 32-byte key. Public; embed in the desktop client.
LICENSE_PUBLIC_KEY=

# Admin panel password.
ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie (HMAC-SHA256), min 16 chars.
ADMIN_SESSION_SECRET=

# Optional: download link included in the WhatsApp message after creating a key.
DOWNLOAD_URL=

# Optional: time zone for showing dates and interpreting expiry dates in the admin panel.
# Default: Asia/Karachi
ADMIN_TIMEZONE=Asia/Karachi
